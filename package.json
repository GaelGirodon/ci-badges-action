{
  "name": "ci-badges-action",
  "version": "1.10.0",
  "description": "Badges for test results and code coverage",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "ncc build index.js",
    "lint": "oxlint --ignore-pattern types.js",
    "test": "node --test src/**/*.test.js",
    "test:e2e": "node --test test/**/*.test.js",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"src/types.js\" --test-coverage-exclude=\"{src,test}/**/*.test.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-report.xml --test-reporter=lcov --test-reporter-destination=lcov.info \"{src,test}/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaelGirodon/ci-badges-action.git"
  },
  "keywords": [
    "github",
    "actions",
    "badge",
    "ci",
    "test",
    "coverage"
  ],
  "author": "Gaël Girodon <contact@gaelgirodon.fr>",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/GaelGirodon/ci-badges-action/issues"
  },
  "homepage": "https://github.com/GaelGirodon/ci-badges-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "oxlint": "^1.92.0"
  }
}
